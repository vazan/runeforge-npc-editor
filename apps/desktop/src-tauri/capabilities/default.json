{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenetre principale : uniquement les commandes IPC de RuneForge Studio (liste dans src/command_names.rs) et l'ecoute d'evenements.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-pick-project-folder",
    "allow-pick-destination-folder",
    "allow-list-recent-projects",
    "allow-open-recent-project",
    "allow-forget-recent-project",
    "allow-scan-project",
    "allow-read-files",
    "allow-write-file",
    "allow-create-directory",
    "allow-recovery-save",
    "allow-recovery-list",
    "allow-recovery-read",
    "allow-recovery-clear",
    "allow-history-list",
    "allow-history-read",
    "allow-config-get",
    "allow-config-set",
    "allow-set-dirty",
    "allow-confirm-exit",
    "allow-e2e-project",
    "allow-log-event",
    "allow-git-status",
    "allow-git-head-file",
    "allow-sftp-dry-run",
    "allow-update-check",
    "allow-update-install",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
